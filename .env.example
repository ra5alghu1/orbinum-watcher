# Collector
ORBINUM_DB=/var/lib/orbinum-monitor/uptime.db
ORBINUM_METRICS_URL=http://127.0.0.1:19615/metrics
ORBINUM_CHAIN=orbinum_testnet
ORBINUM_HTTP_TIMEOUT=5
ORBINUM_VALIDATOR_NAME=robotek8-orbinum
ORBINUM_DASHBOARD_URL=https://orbinum-watcher.xyz

# Public dashboard
ORBINUM_WEB_HOST=127.0.0.1
ORBINUM_WEB_PORT=8787
ORBINUM_STATIC_DIR=/app/static
ORBINUM_EVENTS_FILE=/data/events.json
ORBINUM_PUBLIC_URL=https://orbinum-watcher.xyz

# Telegram bot — fill these locally, never commit real values
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_PAIR_CODE=replace-me

# Validator lifecycle (public SS58 address; no private key)
ORBINUM_VALIDATOR_ACCOUNT=
ORBINUM_LIFECYCLE_STATE_FILE=/home/rasalghul/orbinum-watcher/.validator-lifecycle.json
